            "name": "state_To_Num",
            "language": "st",
            "body": {
              "language": "st",
              "value": "if State = Stopped then\r\n    state_To_Num := 0;\r\nelsif State = Running then\r\n    state_To_Num := 1;\r\nelsif State = Manual then\r\n    state_To_Num := 2;\r\nelse\r\n    state_To_Num := 3;\r\nend_if\r\n"
            },
